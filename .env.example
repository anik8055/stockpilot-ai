# StockPilot AI — environment configuration. Copy to .env.local (development) or set in your host's dashboard.
# Never commit real values.

# ---------------------------------------------------------------- Database (PostgreSQL 15+; Supabase works)
# App connection: the stockpilot_app role (NO superuser, NO BYPASSRLS). Row Level Security protects tenants.
DATABASE_URL=postgres://stockpilot_app:CHANGE_ME@localhost:5432/stockpilot
# Owner connection: runs migrations and identity/session queries. Keep this secret.
DATABASE_ADMIN_URL=postgres://stockpilot:CHANGE_ME@localhost:5432/stockpilot
# Max connections per pool per server instance (serverless: keep small, use a pooler)
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------- App
# Public URL. Must start with https:// in production (enables Secure, __Host- cookies).
APP_URL=http://localhost:3000
SESSION_TTL_DAYS=30
TRIAL_DAYS=14
MAX_IMPORT_FILE_MB=10
MAX_INVOICE_FILE_MB=8
# Optional: token required for /api/health?deep=1 in production (checks the AI provider)
HEALTH_CHECK_TOKEN=

# ---------------------------------------------------------------- File storage (private)
# local: files under STORAGE_DIR (single server / Docker volume). s3: any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_DIR=./.data/storage
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3   (Supabase Storage)  or https://<account>.r2.cloudflarestorage.com
# S3_REGION=ap-south-1
# S3_BUCKET=stockpilot-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- AI (optional — the app works without it)
# none | groq | openai_compatible
AI_PROVIDER=none
GROQ_API_KEY=
# Pick a current production model from https://console.groq.com/docs/models (e.g. llama-3.3-70b-versatile or openai/gpt-oss-20b at the time of writing)
GROQ_MODEL=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Any other OpenAI-compatible endpoint:
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=900

# ---------------------------------------------------------------- OCR for scanned invoices (optional)
# none | tesseract_cli  (needs `tesseract` and `pdftoppm` on the server — included in the Docker image; not available on Vercel)
OCR_PROVIDER=none
TESSERACT_PATH=tesseract

# ---------------------------------------------------------------- Email (optional; needed for password-reset emails in production)
# none | resend
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=StockPilot <no-reply@your-domain.example>

# ---------------------------------------------------------------- Online payments (optional; Razorpay subscriptions)
# Billing is switched on only when the key, secret, webhook secret and at least one plan ID are set.
# Create monthly plans in the Razorpay dashboard (amounts in paise, e.g. 249900 for ₹2,499) and map them here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_IDS=starter:plan_XXXXXXXXXXXXXX,growth:plan_YYYYYYYYYYYYYY
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# ---------------------------------------------------------------- Scheduled weekly report emails (optional)
# The scheduler calls GET /api/cron/weekly-reports with "Authorization: Bearer $CRON_SECRET" every Monday.
# On Vercel, vercel.json already defines the schedule and Vercel sends this header when CRON_SECRET is set.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------- Test-only (never set in production)
# RATE_LIMIT_RELAXED=1
